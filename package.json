{
  "name": "@run-iq/core",
  "version": "1.0.0-next.0",
  "description": "PPE — Parametric Policy Engine core",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --project fast",
    "test:heavy": "vitest run --project heavy --no-file-parallelism --maxWorkers=1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src/ tests/ && prettier --check src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix && prettier --write src/ tests/"
  },
  "keywords": [
    "ppe",
    "policy-engine",
    "rules-engine",
    "parametric"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Run-IQ/core.git"
  },
  "homepage": "https://github.com/Run-IQ/core#readme",
  "bugs": {
    "url": "https://github.com/Run-IQ/core/issues"
  },
  "author": "Abdou-Raouf ATARMLA",
  "license": "BUSL-1.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@run-iq/spec": "^1.0.0-next.1",
    "decimal.js": "^10.4.3"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "minimatch": "^11.0.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
